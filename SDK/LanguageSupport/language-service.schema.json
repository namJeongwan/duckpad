{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:duckpad:language-service:1",
  "title": "Duckpad language service contribution (host API 1.5)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "languageID",
    "displayName",
    "defaultServerID",
    "servers",
    "projectRootMarkers",
    "projectExecutableDirectories"
  ],
  "properties": {
    "languageID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._+-]*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "defaultServerID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._+-]*$"
    },
    "projectRootMarkers": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "projectExecutableDirectories": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "interpreter": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "projectPaths",
            "executableNames"
          ],
          "properties": {
            "projectPaths": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "executableNames": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._+-]*$"
              }
            }
          }
        }
      ]
    },
    "servers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "command",
          "installHint"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._+-]*$"
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "installHint": {
            "type": "string",
            "maxLength": 1024
          },
          "initializationOptions": {},
          "configuration": {}
        }
      }
    }
  }
}
