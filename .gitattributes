# Preserve the exact official Lexilla 5.5.3 source bytes. Its upstream archive
# contains historical whitespace that must not be normalized to satisfy a
# repository diagnostic; Duckpad-owned paths retain Git's strict defaults.
/Vendor/Lexilla/5.5.3/** whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab

# Preserve bundled JavaScript string literals and upstream license notices.
# Do not normalize generated/vendor bytes to satisfy whitespace diagnostics.
/Sources/DuckpadInfrastructure/Resources/Formatter/formatter*.js whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
/Sources/DuckpadInfrastructure/Resources/Formatter/licenses/** whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab

# Preserve generated Markdown engine strings, upstream CSS, and license notices.
/Sources/DuckpadPresentation/Resources/MarkdownPreview/*.js whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
/Sources/DuckpadPresentation/Resources/MarkdownPreview/*.css whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
/Sources/DuckpadPresentation/Resources/MarkdownPreview/THIRD_PARTY_NOTICES.txt whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
