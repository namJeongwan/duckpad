{
  "schemaVersion": 1,
  "id": "com.duckpad.rust",
  "name": "Rust",
  "version": {
    "major": 0,
    "minor": 1,
    "patch": 0
  },
  "api": {
    "minimum": {
      "major": 1,
      "minor": 5,
      "patch": 0
    },
    "maximumExclusive": {
      "major": 2,
      "minor": 0,
      "patch": 0
    }
  },
  "publisher": {
    "id": "com.duckpad",
    "keyID": "language-support-preview-1"
  },
  "runtime": {
    "kind": "language-provider",
    "module": "plugin.json",
    "abi": "duckpad-language-1"
  },
  "capabilities": [
    {
      "id": "language.servers",
      "scope": "application"
    },
    {
      "id": "documents.read",
      "scope": "application"
    }
  ],
  "contributes": {
    "commands": [],
    "keybindings": [],
    "snippets": [],
    "themes": [],
    "languages": [
      {
        "id": "rust",
        "extensions": [
          "rs"
        ]
      }
    ],
    "languageServices": [
      {
        "languageID": "rust",
        "displayName": "Rust",
        "defaultServerID": "rust-analyzer",
        "projectRootMarkers": [
          "Cargo.toml",
          "rust-project.json",
          ".git"
        ],
        "projectExecutableDirectories": [
          ".cargo/bin"
        ],
        "servers": [
          {
            "id": "rust-analyzer",
            "command": [
              "rust-analyzer"
            ],
            "installHint": "rustup component add rust-analyzer"
          }
        ]
      }
    ]
  }
}
